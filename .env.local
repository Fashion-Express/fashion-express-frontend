# The NestJS API. Server-only on purpose: the browser never calls it directly,
# so this must NOT be prefixed with NEXT_PUBLIC_.
API_BASE_URL=http://localhost:3000/api

# This app's own origin. Sent as the Origin header on /api/auth/* requests,
# which better-auth refuses without a trusted one once a session cookie exists.
# It must appear in the backend's TRUSTED_ORIGINS (5173 is there by default).
APP_ORIGIN=http://localhost:5173
